# Переменные окружения для локальной разработки.
# Скопируй в .env.local и заполни. .env.local НЕ коммитится.
#
# ВАЖНО: ключ доступен только серверному коду.
# Никогда не используй префикс NEXT_PUBLIC_ для ключей.

# --- Провайдер LLM (polza.ai, OpenAI-совместимый) ---
POLZA_API_KEY=
POLZA_BASE_URL="https://polza.ai/api/v1"

# --- Модели ---
# Агент / чат: основная нагрузка
LLM_AGENT_MODEL="deepseek/deepseek-v4.1-flash-1017"
# Разбор спорных пар позиций (можно тот же, что агент)
LLM_RESOLVER_MODEL="deepseek/deepseek-v4.1-flash-1017"
# Эмбеддинги для RAG — проверено вживую, возвращает 1024 измерения
EMBEDDING_MODEL="baai/bge-m3"
# Размерность вектора (bge-m3 = 1024)
EMBEDDING_DIM="1024"

# --- LangSmith: трейсинг агента (опционально) ---
# Ключ: https://smith.langchain.com -> Settings -> API Keys
# Без него агент работает, просто без трейсов.
# ВНИМАНИЕ: тексты смет уходят на внешний сервис.
LANGCHAIN_TRACING_V2="false"
LANGCHAIN_API_KEY=""
LANGCHAIN_PROJECT="kp-service"

# --- База данных (Neon / Supabase) ---
# Строка подключения из панели Neon: Connection string -> Node.js
# Пример: postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=""

