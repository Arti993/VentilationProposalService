# Переменные окружения для локальной разработки.
# Скопируй в .env.local и заполни. .env.local НЕ коммитится.
#
# ВАЖНО: ключ доступен только серверному коду.
# Никогда не используй префикс NEXT_PUBLIC_ для ключей.

# --- Провайдер LLM (polza.ai, OpenAI-совместимый) ---
POLZA_API_KEY=
POLZA_BASE_URL="https://polza.ai/api/v1"

# --- Модели ---
# Агент / чат: основная нагрузка
LLM_AGENT_MODEL="deepseek/deepseek-v4.1-flash-1017"
# Разбор спорных пар позиций
LLM_RESOLVER_MODEL="openai/gpt-6.1-terra"
# Эмбеддинги для RAG
EMBEDDING_MODEL="baai/bge-multilingual-gemma2"
# Размерность вектора — заполнить после проверки /api/v1/embeddings
EMBEDDING_DIM=""

# --- База данных (Neon / Supabase) ---
DATABASE_URL=""
