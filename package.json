{
  "name": "ventilation-proposal-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Автоматическая подготовка КП по сметам клиентов: сопоставление позиций с прайс-листом вентиляции",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "node --env-file=.env.local scripts/seed-price.ts",
    "db:status": "node --env-file=.env.local scripts/db-status.ts",
    "normalize": "node scripts/normalize-price.ts",
    "eval": "node scripts/eval.ts",
    "eval:llm": "node --env-file=.env.local scripts/eval-llm.ts",
    "kp": "node --env-file=.env.local scripts/kp.ts",
    "agent": "node --env-file=.env.local scripts/agent.ts",
    "test:parse": "node scripts/test-parse.ts",
    "test:injection": "node --env-file=.env.local scripts/injection-test.ts",
    "test:injection-llm": "node --env-file=.env.local scripts/injection-llm.ts",
    "check": "node scripts/datasets/check.ts",
    "check:price": "node scripts/datasets/check.ts price",
    "check:attack": "node scripts/datasets/check.ts attack",
    "eval:dataset": "node --env-file=.env.local scripts/datasets/evaluate.ts",
    "eval:upload": "node --env-file=.env.local scripts/datasets/upload.ts",
    "eval:verify": "node --env-file=.env.local scripts/datasets/verify-eval.ts",
    "ci": "npm run typecheck && npm run eval && npm run check"
  },
  "dependencies": {
    "@langchain/core": "^0.3.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/openai": "^0.3.0",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.15.3",
    "drizzle-orm": "^0.45.4",
    "langsmith": "^0.12.0",
    "lucide-react": "^1.71.0",
    "mammoth": "^1.13.0",
    "next": "^15.5.29",
    "postcss": "^8.5.32",
    "postgres": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^3.4.19",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.3"
  }
}
